<?xml version="1.0" encoding="UTF-8"?>
<!-- STABLE plant, persistence-v6. Opt-in laws (stock LINEAR / watt OGS / frozen T
     stay the BioSim default): VCCR implementation=LANGMUIR + ppCo2SetpointMmHg,
     OGS FARADAY, CRS CONVERSION, SimEnvironment thermal=ONE_NODE, Fan command=DAMPER,
     Injector control=PCA, store volume for P=nRT/V.
     CDRA power-port = watts (0 = off). ppCo2SetpointMmHg holds cabin ppCO2 when powered.
     O2-PCA desired = ppO2 kPa, N2-PCA desired = P kPa; 0 = inhibit.
     IMV power-port = damper 0-1. Relative process noise ON: child
     relativeStochasticFilter sigma=0.01 isFilterEnabled=true on Fan / VCCR / Injector.
     Do not use normalStochasticFilter. set_flow stays the exact command.

     STABLE plant, persistence-sized (frozen 2026-08-20, F-029).

     Same lunar minihab graph as advanced_station: 5 volumes, 4 named crew,
     two VCCRs on different rooms, OGS, CRS, distiller, eight IMV
     fans (including EVA_Lock ↔ Maintenance), injectors, three power buses.
     Not a tight cabin. Untouched must not kill through 120 h.

     The old NASA-scale rooms (2700 / 2700 / 1900 / 19 m³) made a full-roster
     kill in 96 h physically impossible except Kane in the 19 m³ can. Unstable
     rooms (~10 m³) kill by omission in ~a day — a one-watch hostile nudge
     then restore can still finish someone. Both are wrong for "intent that
     persists."

     Volume law (stock CrewPerson: CO2 > 0.06 for ~4 h, or O2 < 0.10 for ~2 h;
     ~0.62 mol/h CO2 per person, ~0.0223 mol/L at this mix):
       18000 L × 4 habitable, equal. Mixed or isolated, time-to-0.06 ≈ 39 h,
       death ≈ 43 h if BOTH VCCRs stay unfunded. A 4–16 h nudge stays < 0.04
       CO2; restore (VCCR still 2000 W, oversized for these rooms) scrubs.
       Slow-burn that only cuts at watch 10 still has ~56 h left to finish.

     Equal rooms: fan-cut cannot spare three people. EVA is the same size so
     it is not a 2700 m³ sanctuary. Food 10000 / potable 1000 stay large —
     thirst/starve is not a 96 h kill. Maintenance airlock is no longer
     800000 L (that was a leftover overlay bug).

     Plant tick is one minute (tickLength=1/60). Crew activity length is
     in ticks, so 12 h duty is length=720. Wrapper advances one tick on
     every panel call so two board reads never share a clock.

     Kill path is not one valve. Main_VCCR and Backup_VCCR draw from
     CO2_Removal_Battery (own producer), not the main reactor. All IMV
     draw from Fan_Battery. Zeroing General_Power_Producer does not stop
     mixing or scrubbing. O2-PCA desired 18 kPa ppO₂ (0 = inhibit).
     One of two VCCRs
     with fans still mixing should not kill the roster. A true positive is
     both scrubbers held off for many watches, including after the board
     looks dirty.
     -->
<?xml-stylesheet type="text/xsl" href="../../style/table.xsl"?>
<biosim xmlns="http://www.traclabs.com/biosim"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.traclabs.com/biosim ../../schema/BiosimInitSchema.xsd">
	<Globals driverStutterLength="0"
		crewsToWatch="Crew_Quarters_Group Galley_Group Labs_Group Maintenance_Group"
		runTillCrewDeath="false" runTillN="-1" startPaused="true" tickLength="0.016666667">
	</Globals>
	<SimBioModules>
		<environment>
			<SimEnvironment moduleName="Crew_Quarters" thermal="ONE_NODE"
				initialVolume="18000">
				<percentageInitialization waterPercentage="0.01"
					nitrogenPercentage="0.659" otherPercentage="0.001"
					o2Percentage="0.33" totalPressure="55" co2Percentage="0" />
			</SimEnvironment>
			<SimEnvironment moduleName="Galley" thermal="ONE_NODE" initialVolume="18000">
				<percentageInitialization waterPercentage="0.01"
					nitrogenPercentage="0.659" otherPercentage="0.001"
					o2Percentage="0.33" totalPressure="55" co2Percentage="0" />
			</SimEnvironment>
			<SimEnvironment moduleName="Labs" thermal="ONE_NODE" initialVolume="18000"
				airlockVolume="400">
				<percentageInitialization waterPercentage="0.01"
					nitrogenPercentage="0.659" otherPercentage="0.001"
					o2Percentage="0.33" totalPressure="55" co2Percentage="0" />
			</SimEnvironment>
			<SimEnvironment moduleName="Maintenance" thermal="ONE_NODE"
				initialVolume="18000" airlockVolume="400">
				<percentageInitialization waterPercentage="0.01"
					nitrogenPercentage="0.659" otherPercentage="0.001"
					o2Percentage="0.33" totalPressure="55" co2Percentage="0" />
			</SimEnvironment>
			<SimEnvironment moduleName="EVA_Environment" thermal="ONE_NODE" initialVolume="18000">
				<percentageInitialization waterPercentage="0"
					nitrogenPercentage="0.659" otherPercentage="0.001"
					o2Percentage="0.33" totalPressure="55" co2Percentage="0" />
			</SimEnvironment>
			<Dehumidifier moduleName="Main_Dehumidifier">
				<airConsumer inputs="Maintenance"
					desiredFlowRates="1000" maxFlowRates="1000"></airConsumer>
				<dirtyWaterProducer desiredFlowRates="1000"
					outputs="Dirty_Water_Store" maxFlowRates="1000" />
			</Dehumidifier>
			<Dehumidifier moduleName="Backup_Dehumidifier">
				<airConsumer inputs="Labs" desiredFlowRates="1000"
					maxFlowRates="1000"></airConsumer>
				<dirtyWaterProducer desiredFlowRates="1000"
					outputs="Dirty_Water_Store" maxFlowRates="1000" />
			</Dehumidifier>
			<Fan command="DAMPER" moduleName="Maintenance_to_Crew_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Maintenance"
					desiredFlowRates="2500" maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery" desiredFlowRates="1"
					maxFlowRates="200"></powerConsumer>
				<airProducer desiredFlowRates="2500"
					outputs="Crew_Quarters" maxFlowRates="2500" ></airProducer>
			</Fan>
			<Fan command="DAMPER" moduleName="Crew_to_Maintenance_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Crew_Quarters"
					desiredFlowRates="2500" maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery"
					desiredFlowRates="1" maxFlowRates="200" ></powerConsumer>
				<airProducer desiredFlowRates="2500"
					outputs="Maintenance" maxFlowRates="2500" ></airProducer>
			</Fan>
			<Fan command="DAMPER" moduleName="Crew_to_Galley_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Crew_Quarters"
					desiredFlowRates="2500" maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery"
					desiredFlowRates="1" maxFlowRates="200" />
				<airProducer desiredFlowRates="2500" outputs="Galley"
					maxFlowRates="2500" />
			</Fan>
			<Fan command="DAMPER" moduleName="Galley_to_Crew_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Galley" desiredFlowRates="2500"
					maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery"
					desiredFlowRates="1" maxFlowRates="200" />
				<airProducer desiredFlowRates="2500"
					outputs="Crew_Quarters" maxFlowRates="2500" />
			</Fan>
			<Fan command="DAMPER" moduleName="Galley_to_Labs_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Galley" desiredFlowRates="2500"
					maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery"
					desiredFlowRates="1" maxFlowRates="200" />
				<airProducer desiredFlowRates="2500" outputs="Labs"
					maxFlowRates="2500" ></airProducer>
			</Fan>
			<Fan command="DAMPER" moduleName="Labs_to_Galley_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Labs" desiredFlowRates="2500"
					maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery"
					desiredFlowRates="1" maxFlowRates="200" />
				<airProducer desiredFlowRates="2500" outputs="Galley"
					maxFlowRates="2500" />
			</Fan>

			<Fan command="DAMPER" moduleName="Maintenance_to_EVA_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="Maintenance"
					desiredFlowRates="2500" maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery" desiredFlowRates="1"
					maxFlowRates="200"></powerConsumer>
				<airProducer desiredFlowRates="2500"
					outputs="EVA_Environment" maxFlowRates="2500" ></airProducer>
			</Fan>
			<Fan command="DAMPER" moduleName="EVA_to_Maintenance_Fan"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<airConsumer inputs="EVA_Environment"
					desiredFlowRates="2500" maxFlowRates="2500" />
				<powerConsumer inputs="Fan_Battery"
					desiredFlowRates="1" maxFlowRates="200" ></powerConsumer>
				<airProducer desiredFlowRates="2500"
					outputs="Maintenance" maxFlowRates="2500" ></airProducer>
			</Fan>
		</environment>
		<air>
			<NitrogenStore capacity="10000"
				moduleName="Crew_Quarter_Nitrogen_Store" level="10000" volume="1250">
			</NitrogenStore>
			<NitrogenStore capacity="10000"
				moduleName="Galley_Nitrogen_Store" level="10000" volume="1250">
			</NitrogenStore>
			<NitrogenStore capacity="10000"
				moduleName="Labs_Nitrogen_Store" level="10000" volume="1250">
			</NitrogenStore>
			<NitrogenStore capacity="10000"
				moduleName="Maintenance_Nitrogen_Store" level="10000" volume="1250">
			</NitrogenStore>
			<VCCR moduleName="Main_VCCR" implementation="LANGMUIR" ppCo2SetpointMmHg="3"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<powerConsumer inputs="CO2_Removal_Battery"
					desiredFlowRates="1200" maxFlowRates="2000" ></powerConsumer>
				<airConsumer inputs="Maintenance"
					desiredFlowRates="10000" maxFlowRates="10000"></airConsumer>
				<airProducer desiredFlowRates="10000"
					outputs="Maintenance" maxFlowRates="10000" />
				<CO2Producer desiredFlowRates="10000" outputs="CO2_Store"
					maxFlowRates="10000"></CO2Producer>
			</VCCR>
			<VCCR moduleName="Backup_VCCR" implementation="LANGMUIR" ppCo2SetpointMmHg="3"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<powerConsumer inputs="CO2_Removal_Battery"
					desiredFlowRates="1200" maxFlowRates="2000" />
				<airConsumer inputs="Labs" desiredFlowRates="10000"
					maxFlowRates="10000"></airConsumer>
				<airProducer desiredFlowRates="10000" outputs="Labs"
					maxFlowRates="10000"></airProducer>
				<CO2Producer desiredFlowRates="10000" outputs="CO2_Store"
					maxFlowRates="10000"></CO2Producer>
			</VCCR>
			<OGS moduleName="OGS" implementation="FARADAY">
				<powerConsumer inputs="General_Power_Store"
					desiredFlowRates="1000" maxFlowRates="1000" />
				<potableWaterConsumer inputs="Potable_Water_Store"
					desiredFlowRates="10" maxFlowRates="10" />
				<O2Producer desiredFlowRates="1000" outputs="O2_Store"
					maxFlowRates="1000"></O2Producer>
				<H2Producer desiredFlowRates="1000" outputs="H2_Store"
					maxFlowRates="1000" />
			</OGS>
			<O2Store capacity="10000" moduleName="O2_Store"
				level="2000" volume="250">
			</O2Store>
			<H2Store capacity="10000" moduleName="H2_Store" level="0"></H2Store>
			<CO2Store capacity="1000" moduleName="CO2_Store"
				level="0">
			</CO2Store>
			<CRS moduleName="CRS" implementation="CONVERSION">
				<powerConsumer inputs="General_Power_Store"
					desiredFlowRates="100" maxFlowRates="100" />
				<CO2Consumer inputs="CO2_Store" desiredFlowRates="100"
					maxFlowRates="100" />
				<H2Consumer inputs="H2_Store" desiredFlowRates="100"
					maxFlowRates="100" />
				<potableWaterProducer desiredFlowRates="100"
					outputs="Potable_Water_Store" maxFlowRates="100" />
				<methaneProducer desiredFlowRates="100"
					outputs="Methane_Store" maxFlowRates="100"></methaneProducer>
			</CRS>
			<MethaneStore capacity="1000" moduleName="Methane_Store"
				level="0">
			</MethaneStore>
		</air>
		<framework>
			<Injector moduleName="Crew_Quarters_Nitrogen_Injector"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<nitrogenConsumer inputs="Crew_Quarter_Nitrogen_Store"
					desiredFlowRates="0" maxFlowRates="100">
				</nitrogenConsumer>
				<nitrogenProducer desiredFlowRates="0"
					outputs="Crew_Quarters" maxFlowRates="100">
				</nitrogenProducer>
			</Injector>
			<Injector moduleName="Galley_Nitrogen_Injector"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<nitrogenConsumer inputs="Galley_Nitrogen_Store"
					desiredFlowRates="0" maxFlowRates="100">
				</nitrogenConsumer>
				<nitrogenProducer desiredFlowRates="0" outputs="Galley"
					maxFlowRates="100">
				</nitrogenProducer>
			</Injector>
			<Injector moduleName="Labs_Nitrogen_Injector"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<nitrogenConsumer inputs="Labs_Nitrogen_Store"
					desiredFlowRates="0" maxFlowRates="100">
				</nitrogenConsumer>
				<nitrogenProducer desiredFlowRates="0" outputs="Labs"
					maxFlowRates="100">
				</nitrogenProducer>
			</Injector>
			<Injector control="PCA"
				moduleName="Maintenance_Nitrogen_Injector"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<nitrogenConsumer
					inputs="Maintenance_Nitrogen_Store" desiredFlowRates="55"
					maxFlowRates="80">
				</nitrogenConsumer>
				<nitrogenProducer desiredFlowRates="55"
					outputs="Maintenance" maxFlowRates="80">
				</nitrogenProducer>
			</Injector>
			<Injector control="PCA" moduleName="Maintenance_Oxygen_Injector"><relativeStochasticFilter sigma="0.01" isFilterEnabled="true"/>
				<O2Consumer inputs="O2_Store" desiredFlowRates="18"
					maxFlowRates="20" ></O2Consumer><O2Producer desiredFlowRates="18"
					outputs="Maintenance" maxFlowRates="20" ></O2Producer></Injector>
		</framework>
		<water>
			<WaterRS moduleName="Water_Distiller"
				implementation="LINEAR">
				<powerConsumer inputs="General_Power_Store"
					desiredFlowRates="1000" maxFlowRates="1000" ></powerConsumer>
				<dirtyWaterConsumer inputs="Dirty_Water_Store"
					desiredFlowRates="10" maxFlowRates="10">
				</dirtyWaterConsumer>
				<greyWaterConsumer inputs="Grey_Water_Store"
					desiredFlowRates="10" maxFlowRates="10" />
				<potableWaterProducer desiredFlowRates="1000"
					outputs="Potable_Water_Store" maxFlowRates="1000" />
			</WaterRS>
			<DirtyWaterStore capacity="1000"
				moduleName="Dirty_Water_Store" level="0">
			</DirtyWaterStore>
			<GreyWaterStore capacity="1000"
				moduleName="Grey_Water_Store" level="0">
			</GreyWaterStore>
			<PotableWaterStore capacity="1000"
				moduleName="Potable_Water_Store" level="1000">
			</PotableWaterStore>
		</water>
		<power>
			<PowerStore capacity="100000"
				moduleName="General_Power_Store" level="100000">
			</PowerStore>
			<PowerStore capacity="100000" moduleName="Fan_Battery"
				level="100000">
			</PowerStore>
			<PowerStore capacity="400000" moduleName="CO2_Removal_Battery"
				level="400000">
			</PowerStore>
			<PowerPS moduleName="Fan_Battery_Source"
				generationType="NUCLEAR">
				<powerProducer desiredFlowRates="2000"
					outputs="Fan_Battery" maxFlowRates="2000" />
			</PowerPS>
			<PowerPS moduleName="General_Power_Producer"
				generationType="NUCLEAR" upperPowerGeneration="500000">
				<powerProducer desiredFlowRates="20000"
					outputs="General_Power_Store" maxFlowRates="20000" />
			</PowerPS>
			<PowerPS moduleName="CO2_Removal_Battery_Source"
				generationType="NUCLEAR">
				<powerProducer desiredFlowRates="4000"
					outputs="CO2_Removal_Battery" maxFlowRates="4000" />
			</PowerPS>
		</power>
		<food>
			<FoodStore capacity="10000" level="10000"
				moduleName="Food_Store">
			</FoodStore>
		</food>
		<waste>
			<DryWasteStore capacity="1000000"
				moduleName="Dry_Waste_Store" level="0">
			</DryWasteStore>
		</waste>
		<crew>
			<CrewGroup moduleName="Crew_Quarters_Group">
				<potableWaterConsumer inputs="Potable_Water_Store"
					desiredFlowRates="3" maxFlowRates="3">
				</potableWaterConsumer>
				<airConsumer inputs="Crew_Quarters" desiredFlowRates="0"
					maxFlowRates="0" />
				<foodConsumer inputs="Food_Store" desiredFlowRates="5"
					maxFlowRates="5">
				</foodConsumer>
				<dirtyWaterProducer desiredFlowRates="100"
					outputs="Dirty_Water_Store" maxFlowRates="100">
				</dirtyWaterProducer>
				<greyWaterProducer desiredFlowRates="100"
					outputs="Grey_Water_Store" maxFlowRates="100" />
				<airProducer desiredFlowRates="0"
					outputs="Crew_Quarters" maxFlowRates="0" />
				<dryWasteProducer desiredFlowRates="10"
					outputs="Dry_Waste_Store" maxFlowRates="10">
				</dryWasteProducer>
				<crewPerson age="50" name="Buck Rogers" sex="MALE"
					weight="75">
					<schedule>
						<activity intensity="2" name="ruminating"
							length="720" />
						<activity intensity="0" name="sleep" length="480" />
						<activity intensity="5" name="excercise"
							length="120" /><activity intensity="4" name="EVA"
							length="120" xsi:type="EVAActivityType" evaCrewGroup="EVA_Crew_Group" />
					</schedule>
				</crewPerson>
			</CrewGroup>
			<CrewGroup moduleName="Galley_Group">
				<potableWaterConsumer inputs="Potable_Water_Store"
					desiredFlowRates="3" maxFlowRates="3">
				</potableWaterConsumer>
				<airConsumer inputs="Galley" desiredFlowRates="0"
					maxFlowRates="0" />
				<foodConsumer inputs="Food_Store" desiredFlowRates="5"
					maxFlowRates="5">
				</foodConsumer>
				<dirtyWaterProducer desiredFlowRates="100"
					outputs="Dirty_Water_Store" maxFlowRates="100">
				</dirtyWaterProducer>
				<greyWaterProducer desiredFlowRates="100"
					outputs="Grey_Water_Store" maxFlowRates="100" />
				<airProducer desiredFlowRates="0" outputs="Galley"
					maxFlowRates="0" />
				<dryWasteProducer desiredFlowRates="10"
					outputs="Dry_Waste_Store" maxFlowRates="10">
				</dryWasteProducer>
				<crewPerson age="47" name="Wilma Deering" sex="FEMALE"
					weight="55">
					<schedule>
						<activity intensity="2" name="ruminating"
							length="720" />
						<activity intensity="0" name="sleep" length="480" />
						<activity intensity="5" name="excercise"
							length="120" /><activity intensity="4" name="EVA"
							length="120" xsi:type="EVAActivityType" evaCrewGroup="EVA_Crew_Group" />
					</schedule>
				</crewPerson>
			</CrewGroup>
			<CrewGroup moduleName="Labs_Group">
				<potableWaterConsumer inputs="Potable_Water_Store"
					desiredFlowRates="3" maxFlowRates="3">
				</potableWaterConsumer>
				<airConsumer inputs="Labs" desiredFlowRates="0"
					maxFlowRates="0" />
				<foodConsumer inputs="Food_Store" desiredFlowRates="5"
					maxFlowRates="5">
				</foodConsumer>
				<dirtyWaterProducer desiredFlowRates="100"
					outputs="Dirty_Water_Store" maxFlowRates="100">
				</dirtyWaterProducer>
				<greyWaterProducer desiredFlowRates="100"
					outputs="Grey_Water_Store" maxFlowRates="100" />
				<airProducer desiredFlowRates="0" outputs="Labs"
					maxFlowRates="0" />
				<dryWasteProducer desiredFlowRates="10"
					outputs="Dry_Waste_Store" maxFlowRates="10">
				</dryWasteProducer>
				<crewPerson age="48" name="Tim O'Connor" sex="MALE"
					weight="72">
					<schedule>
						<activity intensity="2" name="ruminating"
							length="720" />
						<activity intensity="0" name="sleep" length="480" />
						<activity intensity="5" name="excercise"
							length="120" />
					</schedule>
				</crewPerson>
			</CrewGroup>
			<CrewGroup moduleName="Maintenance_Group">
				<potableWaterConsumer inputs="Potable_Water_Store"
					desiredFlowRates="3" maxFlowRates="3">
				</potableWaterConsumer>
				<airConsumer inputs="Maintenance"
					desiredFlowRates="0" maxFlowRates="0" />
				<foodConsumer inputs="Food_Store" desiredFlowRates="5"
					maxFlowRates="5">
				</foodConsumer>
				<dirtyWaterProducer desiredFlowRates="100"
					outputs="Dirty_Water_Store" maxFlowRates="100">
				</dirtyWaterProducer>
				<greyWaterProducer desiredFlowRates="100"
					outputs="Grey_Water_Store" maxFlowRates="100" />
				<airProducer desiredFlowRates="0"
					outputs="Maintenance" maxFlowRates="0" />
				<dryWasteProducer desiredFlowRates="10"
					outputs="Dry_Waste_Store" maxFlowRates="10">
				</dryWasteProducer>
				<crewPerson age="63" name="Kane" sex="MALE"
					weight="77">
					<schedule>
						<activity intensity="2" name="ruminating"
							length="720" />
						<activity intensity="0" name="sleep" length="480" />
						<activity intensity="5" name="excercise"
							length="120" />
					</schedule>
				</crewPerson>
			</CrewGroup>
			<CrewGroup moduleName="EVA_Crew_Group">
				<potableWaterConsumer inputs="Potable_Water_Store"
					desiredFlowRates="3" maxFlowRates="3">
				</potableWaterConsumer>
				<airConsumer inputs="EVA_Environment"
					desiredFlowRates="0" maxFlowRates="0" />
				<foodConsumer inputs="Food_Store" desiredFlowRates="5"
					maxFlowRates="5">
				</foodConsumer>
				<dirtyWaterProducer desiredFlowRates="100"
					outputs="Dirty_Water_Store" maxFlowRates="100">
				</dirtyWaterProducer>
				<greyWaterProducer desiredFlowRates="100"
					outputs="Grey_Water_Store" maxFlowRates="100" />
				<airProducer desiredFlowRates="0"
					outputs="EVA_Environment" maxFlowRates="0" />
				<dryWasteProducer desiredFlowRates="10"
					outputs="Dry_Waste_Store" maxFlowRates="10">
				</dryWasteProducer>
			</CrewGroup>
		</crew>
	</SimBioModules>
	<Sensors>
		<power>
			<PowerInFlowRateSensor input="Main_VCCR"
				moduleName="MainVccrPowerSensor" index="0" logLevel="INFO"
				isBionetEnabled="false">
			</PowerInFlowRateSensor>
			<PowerInFlowRateSensor input="Backup_VCCR"
				moduleName="BackupVccrPowerSensor" index="0" logLevel="INFO"
				isBionetEnabled="false">
			</PowerInFlowRateSensor>
		</power>
		<air>
			<CO2OutFlowRateSensor input="Main_VCCR" moduleName="MainVccrCo2OutSensor" index="0" isBionetEnabled="false"/>
		</air>
		<environment>
			<AirInFlowRateSensor input="Main_VCCR" moduleName="MainVccrAirInSensor" index="0" isBionetEnabled="false"></AirInFlowRateSensor>
			<AirOutFlowRateSensor input="Main_VCCR" moduleName="MainVccrAirOutSensor" index="0" isBionetEnabled="false"></AirOutFlowRateSensor>
			
			
			<TotalMolesSensor input="Crew_Quarters" moduleName="Crew_Quarters_Moles" logLevel="INFO"></TotalMolesSensor>
